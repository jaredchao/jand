# Add this server block to the existing Nginx configuration after issuing a
# valid certificate for the chosen domain. Do not replace unrelated vhosts.
server {
    listen 443 ssl;
    server_name jand.example.com;
    ssl_certificate /etc/letsencrypt/live/jand.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jand.example.com/privkey.pem;

    # The Go relay accepts one ciphertext up to 10 MiB plus envelope bytes.
    client_max_body_size 11m;
    access_log off; # URLs contain room identifiers.
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
